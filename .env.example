NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
CRON_SECRET=

# Supabase Edge Function secrets:
# SUPABASE_URL is provided by Supabase.
# SUPABASE_SECRET_KEYS is provided by Supabase on projects using the current API key system.
# SUPABASE_SERVICE_ROLE_KEY is legacy and is only used as a fallback by the Edge Function.
# CRON_SECRET must match the secret used in the Supabase Cron SQL.
